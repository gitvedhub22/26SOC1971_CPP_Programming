#include <iostream>
using namespace std;

class Product
{
    int id;
    float price;
    int sales[12];

public:
    void input()
    {
        cout << "Enter product id: ";
        cin >> id;

        cout << "Enter price: ";
        cin >> price;

        cout << "Enter sales of 12 months:\n";

        for (int i = 0; i < 12; i++)
            cin >> sales[i];
    }

    void display()
    {
        int total = 0;

        for (int i = 0; i < 12; i++)
            total = total + sales[i];

        cout << "\nProduct ID: " << id;
        cout << "\nTotal Sales: " << total;
        cout << "\nTotal Amount: " << total * price << endl;
    }
};

int main()
{
    Product p[2];

    for (int i = 0; i < 2; i++)
    {
        cout << "\nProduct " << i + 1 << endl;
        p[i].input();
    }

    for (int i = 0; i < 2; i++)
    {
        cout << "\nProduct " << i + 1 << " Details";
        p[i].display();
    }

    return 0;
}
