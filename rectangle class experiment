#include <iostream>
using namespace std;

class Rectangle
{
    float l, b;

public:
    void input()
    {
        cout << "Enter length: ";
        cin >> l;

        cout << "Enter breadth: ";
        cin >> b;
    }

    void area()
    {
        cout << "Area = " << l * b << endl;
    }

    void perimeter()
    {
        cout << "Perimeter = " << 2 * (l + b) << endl;
    }
};

int main()
{
    Rectangle r;

    r.input();
    r.area();
    r.perimeter();

    return 0;
}
